# Copy this file to .env and fill in your own keys.
# Never commit the real .env file — it's already in .gitignore.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

LLM_PROVIDER=groq

# Critic agent (optional — these are the defaults)
CRITIC_MODEL=openai/gpt-oss-20b
MAX_REVISIONS=2

# Backup writer model when the main one hits a rate limit (has its own daily allowance)
FALLBACK_MODEL=openai/gpt-oss-20b

# Public demo protection — leave at 0 (unlimited) when running on your own machine
TAVILY_SEARCH_DEPTH=advanced
PLANS_PER_IP_PER_DAY=0
CHATS_PER_IP_PER_DAY=0
DAILY_PLAN_LIMIT=0
